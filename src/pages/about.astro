    .visit{position:relative;min-height:100svh;color:#fff;background:var(--ink)}.visit__image{position:absolute;inset:0}.visit__image img{height:100%;object-fit:cover;object-position:center 42%}.visit__image:after{position:absolute;inset:0;background:linear-gradient(180deg,rgba(17,17,15,.05),rgba(17,17,15,.16) 35%,rgba(17,17,15,.95) 86%);content:""}.visit__copy{position:relative;z-index:2;display:flex;min-height:100svh;flex-direction:column;justify-content:flex-end;padding:80px var(--gutter) max(44px,env(safe-area-inset-bottom))}.visit h2{max-width:650px;margin-bottom:18px}.visit p{max-width:32rem;color:#dedad1;font-size:1.02rem}.visit .button{width:100%;margin-top:10px}.visit__details{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:24px;color:#bdb9b0;font:600 .67rem var(--display);letter-spacing:.05em;text-transform:uppercase}.footer{padding:35px var(--gutter) max(28px,env(safe-area-inset-bottom));color:#aaa89f;background:var(--ink);border-top:1px solid #35342f;font:400 .7rem var(--display)}.footer__row{display:flex;align-items:flex-end;justify-content:space-between;gap:22px}.footer__brand{width:154px;padding:7px 0 12px;filter:invert(1)}.footer a{text-decoration:none}
    [data-reveal]{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}[data-reveal].visible{opacity:1;transform:none}@media(min-width:620px){.origin__image{margin-inline:0;border-radius:5px}.work{display:grid;grid-template-columns:1fr 1fr;min-height:760px}.work__image{height:100%}.work__copy{display:flex;flex-direction:column;justify-content:center}.evidence__grid{grid-template-columns:1fr 1fr}.method{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}.method__image{margin:0}.visit .button{width:auto;min-width:220px;align-self:flex-start}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition-duration:.001ms!important}[data-reveal]{opacity:1;transform:none}}
