<!doctype html><html lang="en" data-astro-page="contact"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact BHIC | Bugungu Heritage and Information Centre</title><meta name="description" content="Contact BHIC to plan a visit, share knowledge, collaborate or support Bugungu heritage."><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#11110f;--paper:#fff;--warm:#f5f0e7;--ochre:#d9780d;--lake:#315f63;--line:#d9d3c8;--pad:clamp(20px,6vw,76px)}*{box-sizing:border-box}body{margin:0;color:var(--ink);font-family:Lora,Georgia,serif;line-height:1.55;background:var(--warm)}img{display:block;width:100%}a{color:inherit}h1,h2,h3,.eyebrow,.btn,.nav,label,select,input,textarea{font-family:Montserrat,Arial,sans-serif}.eyebrow{margin:0 0 12px;color:#ad5b00;text-transform:uppercase;letter-spacing:.17em;font-weight:700;font-size:.73rem}.header{height:82px;padding:13px var(--pad);display:flex;align-items:center;justify-content:space-between;background:#fff;position:relative;z-index:5}.brand img{width:156px}.menu{width:48px;height:48px;border:0;background:transparent;padding:10px}.menu span{display:block;height:2px;background:#111;margin:7px 0}.drawer{position:fixed;inset:0;background:#111;color:#fff;z-index:10;padding:24px var(--pad);transform:translateX(100%);transition:.3s}.drawer.open{transform:none}.drawer__top{display:flex;justify-content:space-between;align-items:center}.drawer__top img{width:150px;filter:invert(1)}.close{font-size:2rem;border:0;color:#fff;background:none}.nav{display:grid;margin-top:54px}.nav a{font-size:clamp(1.5rem,8vw,3rem);padding:15px 0;text-decoration:none;border-bottom:1px solid #333}.nav a[aria-current]{color:#f39a2e}.hero{background:#fff;padding:44px var(--pad) 56px;display:grid;gap:30px}.hero h1{font-size:clamp(2.8rem,12vw,6rem);line-height:.95;letter-spacing:-.06em;margin:0;max-width:9ch}.hero__lead{font-size:clamp(1.08rem,4.8vw,1.45rem);max-width:34ch;margin:18px 0 0}.hero figure{margin:0;min-height:360px;overflow:hidden}.hero figure img{height:100%;object-fit:cover;object-position:center}.route{padding:65px var(--pad)}.route h2,.form h2{font-size:clamp(2rem,8.5vw,4.2rem);line-height:1.02;letter-spacing:-.045em;margin:0;max-width:12ch}.routes{display:grid;gap:10px;margin-top:30px}.routecard{width:100%;text-align:left;border:1px solid var(--line);background:#fff;padding:22px;display:grid;grid-template-columns:44px 1fr 25px;gap:12px;align-items:center;color:#111;cursor:pointer}.routecard:hover,.routecard.active{border-color:var(--ochre);box-shadow:inset 5px 0 0 var(--ochre)}.routecard__icon{font:700 .75rem Montserrat;color:var(--ochre)}.routecard h3{font-size:1.05rem;margin:0 0 3px}.routecard p{margin:0;color:#625c53;font-size:.93rem}.routecard span:last-child{font-size:1.3rem}.direct{background:#111;color:#fff;padding:50px var(--pad);display:grid;gap:22px}.direct h2{font-size:1.6rem;margin:0}.directlinks{display:grid;gap:10px}.directlinks a{border:1px solid #3c3c39;text-decoration:none;padding:16px;font-family:Montserrat;font-weight:600}.directlinks small{display:block;color:#aaa;font-family:Lora;font-weight:400}.form{padding:70px var(--pad);background:#fff}.form__box{margin-top:32px;display:grid;gap:18px;max-width:760px}.field{display:grid;gap:7px}.field label{font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em}.field input,.field select,.field textarea{width:100%;border:1px solid #aaa;background:#fff;border-radius:0;padding:15px;font-size:16px;color:#111}.field textarea{min-height:150px;resize:vertical}.btn{border:2px solid var(--ochre);background:var(--ochre);color:#111;min-height:54px;padding:14px 20px;font-weight:700;font-size:.9rem;cursor:pointer}.helper{font-size:.84rem;color:#6b655d;margin:0}.sentnote{display:none;margin-top:15px;padding:18px;background:var(--warm);border-left:5px solid var(--ochre)}.footer{background:#111;color:#fff;padding:52px var(--pad)}.footer img{width:170px;filter:invert(1);margin:0 0 28px}.footer nav{display:flex;flex-wrap:wrap;gap:15px 24px;font-family:Montserrat;font-size:.82rem}.footer small{display:block;color:#aaa;margin-top:36px}
@media(min-width:780px){.hero{grid-template-columns:1fr 1fr;align-items:center;padding-top:70px;padding-bottom:70px}.hero figure{height:540px}.routes{grid-template-columns:1fr 1fr}.direct{grid-template-columns:1fr 1fr}.form__box{grid-template-columns:1fr 1fr}.field--full,.btn,.helper,.sentnote{grid-column:1/-1}}
</style></head><body>
<header class="header"><a class="brand" href="/" aria-label="BHIC home"><img src="/assets/7732233b3dc43e88.png" alt="Bugungu"></a><button class="menu" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button></header><aside class="drawer" aria-hidden="true"><div class="drawer__top"><img src="/assets/7732233b3dc43e88.png" alt="Bugungu"><button class="close" aria-label="Close menu">×</button></div><nav class="nav"><a href="/">Home</a><a href="/about/">About</a><a href="/heritage/">Heritage &amp; Museum</a><a href="/visit/">Visit</a><a href="/contact/" aria-current="page">Contact</a><a href="/support/">Support</a></nav></aside>
<main><section class="hero"><div><p class="eyebrow">Start here</p><h1>What brings you to BHIC?</h1><p class="hero__lead">Choose the reason closest to yours. We will help your message reach the right conversation.</p></div><figure><img src="/assets/bc9474d0bfb847cd.webp" alt="BHIC team and community members in conversation outside the centre"></figure></section>
<section class="route"><p class="eyebrow">Choose one</p><h2>Help us understand your next step.</h2><div class="routes"><button class="routecard" data-reason="visit"><span class="routecard__icon">01</span><span><h3>Plan a visit</h3><p>Individual, family, school, group or researcher.</p></span><span>→</span></button><button class="routecard" data-reason="story"><span class="routecard__icon">02</span><span><h3>Share a story or object</h3><p>Tell BHIC what your family or community knows.</p></span><span>→</span></button><button class="routecard" data-reason="partner"><span class="routecard__icon">03</span><span><h3>Work with BHIC</h3><p>Partnerships, learning, research and media.</p></span><span>→</span></button><button class="routecard" data-reason="support"><span class="routecard__icon">04</span><span><h3>Support the work</h3><p>Ask for the current verified way to contribute.</p></span><span>→</span></button></div></section>
<section class="direct"><div><p class="eyebrow" style="color:#ffad4d">Prefer direct contact?</p><h2>Call or email the team.</h2></div><div class="directlinks"><a href="tel:+256392585818">+256 392 585818<small>Tap to call BHIC</small></a><a href="mailto:bugunguheritage@gmail.com">bugunguheritage@gmail.com<small>Open your email app</small></a></div></section>
<section class="form" id="message"><p class="eyebrow">Write to us</p><h2>Say enough to get started.</h2><form class="form__box" id="contactForm"><div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required></div><div class="field"><label for="reply">Email or phone</label><input id="reply" name="reply" autocomplete="email" required></div><div class="field field--full"><label for="reason">Reason for contacting</label><select id="reason" name="reason"><option value="general">General enquiry</option><option value="visit">Plan a visit</option><option value="story">Share a story or object</option><option value="partner">Partnership, research or media</option><option value="support">Support BHIC</option></select></div><div class="field field--full"><label for="messageText">Your message</label><textarea id="messageText" name="message" required placeholder="Tell us what you would like to do, and any useful dates or details."></textarea></div><button class="btn" type="submit">Continue in email</button><p class="helper">This opens your email app with your message prepared. You can review it before sending.</p><div class="sentnote" role="status">Your email app should now be open. If it is not, email bugunguheritage@gmail.com directly.</div></form></section></main>
<footer class="footer"><img src="/assets/7732233b3dc43e88.png" alt="Bugungu"><nav><a href="/about/">About</a><a href="/heritage/">Heritage</a><a href="/visit/">Visit</a><a href="/support/">Support BHIC</a></nav><small>Bugungu Heritage and Information Centre · Buliisa, Uganda</small></footer>
<script is:inline>const drawer=document.querySelector('.drawer'),op=document.querySelector('.menu'),cl=document.querySelector('.close');function setMenu(v){drawer.classList.toggle('open',v);drawer.setAttribute('aria-hidden',!v);op.setAttribute('aria-expanded',v)}op.onclick=()=>setMenu(true);cl.onclick=()=>setMenu(false);const reason=document.querySelector('#reason');function choose(v){reason.value=v;document.querySelectorAll('.routecard').forEach(x=>x.classList.toggle('active',x.dataset.reason===v));document.querySelector('#message').scrollIntoView({behavior:'smooth'})}document.querySelectorAll('.routecard').forEach(x=>x.onclick=()=>choose(x.dataset.reason));const incoming=new URLSearchParams(location.search).get('reason');if(incoming&&[...reason.options].some(o=>o.value===incoming)){reason.value=incoming;document.querySelectorAll('.routecard').forEach(x=>x.classList.toggle('active',x.dataset.reason===incoming))}document.querySelector('#contactForm').addEventListener('submit',e=>{e.preventDefault();const d=new FormData(e.currentTarget),labels={visit:'Planning a visit',story:'Sharing a Bugungu story or object',partner:'Working with BHIC',support:'Supporting BHIC',general:'General enquiry'},subject=labels[d.get('reason')],body=`Name: ${d.get('name')}\nReply to: ${d.get('reply')}\nReason: ${subject}\n\n${d.get('message')}`;location.href=`mailto:bugunguheritage@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;document.querySelector('.sentnote').style.display='block'})</script></body></html>
