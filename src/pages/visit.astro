  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Lora,Georgia,serif;line-height:1.55}img{display:block;width:100%}a{color:inherit}h1,h2,h3,.eyebrow,.btn,.nav,.label{font-family:Montserrat,Arial,sans-serif}.eyebrow{margin:0 0 12px;color:#ad5b00;text-transform:uppercase;letter-spacing:.17em;font-weight:700;font-size:.73rem}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;background:#fff;padding:10px;z-index:20}.header{height:82px;padding:13px var(--pad);display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid #eee;position:relative;z-index:5}.brand img{width:156px;height:auto}.menu{width:48px;height:48px;border:0;background:transparent;padding:10px;cursor:pointer}.menu span{display:block;height:2px;background:#111;margin:7px 0}.drawer{position:fixed;inset:0;background:#111;color:#fff;z-index:10;padding:24px var(--pad);transform:translateX(100%);transition:.3s}.drawer.open{transform:none}.drawer__top{display:flex;justify-content:space-between;align-items:center}.drawer__top img{width:150px;filter:invert(1)}.close{font-size:2rem;border:0;color:#fff;background:transparent}.nav{display:grid;margin-top:54px}.nav a{font-size:clamp(1.5rem,8vw,3rem);padding:15px 0;text-decoration:none;border-bottom:1px solid #333}.nav a[aria-current]{color:#f39a2e}.hero{position:relative;min-height:calc(100svh - 82px);display:grid;align-items:end;overflow:hidden}.hero>img{position:absolute;inset:0;height:100%;object-fit:cover;object-position:58% center}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.04) 30%,rgba(0,0,0,.84) 100%)}.hero__copy{position:relative;z-index:1;color:#fff;padding:42px var(--pad) 34px;max-width:780px}.hero .eyebrow{color:#ffb45c}.hero h1{font-size:clamp(2.65rem,12vw,5.8rem);line-height:.98;letter-spacing:-.055em;margin:0 0 18px;max-width:9ch}.hero p{font-size:clamp(1.1rem,4.8vw,1.5rem);margin:0 0 26px;max-width:32ch}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:54px;padding:14px 20px;border:2px solid var(--ochre);background:var(--ochre);color:#111;text-decoration:none;font-weight:700;font-size:.9rem}.btn--light{background:#fff;border-color:#fff}.intro{padding:74px var(--pad);display:grid;gap:36px}.intro h2,.moments h2,.plan h2,.closevisit h2{font-size:clamp(2.1rem,9vw,4.4rem);line-height:1.02;letter-spacing:-.045em;margin:0}.facts{border-top:1px solid var(--line)}.fact{display:grid;grid-template-columns:92px 1fr;gap:16px;padding:18px 0;border-bottom:1px solid var(--line)}.fact .label{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:#6a6359}.fact p{margin:0;font-size:1.05rem}.moments{padding:72px var(--pad);background:var(--warm)}.momentgrid{display:grid;gap:12px;margin-top:36px}.moment{min-height:300px;position:relative;overflow:hidden;background:#222;color:#fff}.moment img{position:absolute;inset:0;height:100%;object-fit:cover}.moment:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 25%,rgba(0,0,0,.82))}.moment__copy{position:absolute;z-index:1;bottom:0;padding:24px}.moment h3{margin:0 0 6px;font-size:1.5rem;line-height:1.05}.moment p{margin:0;max-width:28ch}.moment--text{background:var(--lake);display:flex;align-items:end}.moment--text:after{display:none}.plan{padding:76px var(--pad)}.steps{counter-reset:steps;display:grid;margin-top:32px;border-top:1px solid var(--line)}.step{counter-increment:steps;display:grid;grid-template-columns:42px 1fr;gap:16px;padding:24px 0;border-bottom:1px solid var(--line)}.step:before{content:"0" counter(steps);font:700 .72rem Montserrat;color:var(--ochre);padding-top:5px}.step h3{font-size:1.05rem;margin:0 0 6px}.step p{margin:0;color:#514c45}.note{margin-top:30px;padding:22px;background:var(--warm);border-left:5px solid var(--ochre)}.note strong{font-family:Montserrat}.closevisit{min-height:100svh;background:var(--ochre);padding:70px var(--pad);display:flex;flex-direction:column;justify-content:center}.closevisit h2{max-width:10ch}.closevisit p{font-size:1.18rem;max-width:31ch;margin:22px 0 30px}.micro{font-size:.84rem!important;margin:16px 0 0!important}.footer{background:#111;color:#fff;padding:52px var(--pad)}.footer img{width:170px;filter:invert(1);margin:0 0 28px}.footer nav{display:flex;flex-wrap:wrap;gap:15px 24px;font-family:Montserrat;font-size:.82rem}.footer small{display:block;color:#aaa;margin-top:36px}
