<!doctype html><html lang="en" data-astro-page="support"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Support BHIC | Keep Bugungu Heritage Living</title><meta name="description" content="Support community-led work to record, teach and share Bugungu heritage."><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#11110f;--paper:#fff;--warm:#f5f0e7;--ochre:#d9780d;--lake:#315f63;--line:#d9d3c8;--pad:clamp(20px,6vw,76px)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:Lora,Georgia,serif;line-height:1.55}img{display:block;width:100%}a{color:inherit}h1,h2,h3,.eyebrow,.btn,.nav,.num{font-family:Montserrat,Arial,sans-serif}.eyebrow{margin:0 0 12px;color:#ad5b00;text-transform:uppercase;letter-spacing:.17em;font-weight:700;font-size:.73rem}.header{height:82px;padding:13px var(--pad);display:flex;align-items:center;justify-content:space-between;background:#fff;position:relative;z-index:5}.brand img{width:156px}.menu{width:48px;height:48px;border:0;background:transparent;padding:10px}.menu span{display:block;height:2px;background:#111;margin:7px 0}.drawer{position:fixed;inset:0;background:#111;color:#fff;z-index:10;padding:24px var(--pad);transform:translateX(100%);transition:.3s}.drawer.open{transform:none}.drawer__top{display:flex;justify-content:space-between;align-items:center}.drawer__top img{width:150px;filter:invert(1)}.close{font-size:2rem;border:0;color:#fff;background:none}.nav{display:grid;margin-top:54px}.nav a{font-size:clamp(1.5rem,8vw,3rem);padding:15px 0;text-decoration:none;border-bottom:1px solid #333}.nav a[aria-current]{color:#f39a2e}.hero{min-height:calc(100svh - 82px);display:grid;background:#111;color:#fff}.hero__image{min-height:43svh;position:relative;overflow:hidden}.hero__image img{position:absolute;inset:0;height:100%;object-fit:cover}.hero__copy{padding:36px var(--pad) 52px;display:flex;flex-direction:column;justify-content:center}.hero .eyebrow{color:#ffad4d}.hero h1{font-size:clamp(2.55rem,11vw,5.5rem);line-height:.98;letter-spacing:-.055em;margin:0 0 18px;max-width:11ch}.hero p{font-size:clamp(1.05rem,4.7vw,1.42rem);max-width:34ch;margin:0 0 26px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:54px;padding:14px 20px;border:2px solid var(--ochre);background:var(--ochre);color:#111;text-decoration:none;font:700 .9rem Montserrat}.thesis{padding:78px var(--pad);background:var(--warm)}.thesis blockquote{font:500 clamp(2rem,9vw,4.5rem)/1.08 Lora;margin:0;max-width:19ch}.thesis p{font-size:1.05rem;max-width:45ch;margin:28px 0 0}.choices{padding:76px var(--pad)}.choices h2,.proof h2,.give h2,.other h2{font-size:clamp(2.05rem,8.8vw,4.4rem);line-height:1.02;letter-spacing:-.045em;margin:0}.choicegrid{display:grid;margin-top:34px;border-top:1px solid var(--line)}.choice{display:grid;grid-template-columns:50px 1fr;gap:14px;padding:25px 0;border-bottom:1px solid var(--line)}.num{color:var(--ochre);font-size:.75rem;font-weight:700;padding-top:5px}.choice h3{font-size:1.15rem;margin:0 0 7px}.choice p{margin:0;color:#5b554d;max-width:35ch}.proof{background:var(--lake);color:#fff}.proof__image{height:55svh;overflow:hidden}.proof__image img{height:100%;object-fit:cover}.proof__copy{padding:50px var(--pad) 64px}.proof .eyebrow{color:#ffb45c}.proof p{font-size:1.1rem;max-width:38ch;margin:18px 0 0}.give{padding:80px var(--pad);background:var(--ochre);min-height:100svh;display:flex;flex-direction:column;justify-content:center}.give h2{max-width:11ch}.give>p:not(.eyebrow){font-size:1.13rem;max-width:35ch;margin:22px 0}.givebox{background:#fff;padding:24px;margin:10px 0 25px}.givebox h3{margin:0 0 8px;font-size:1.05rem}.givebox p{margin:0}.give .btn{background:#111;border-color:#111;color:#fff}.safe{font-size:.83rem!important;margin:15px 0 0!important}.other{padding:76px var(--pad)}.othergrid{display:grid;gap:10px;margin-top:30px}.othercard{border:1px solid var(--line);padding:23px;text-decoration:none}.othercard h3{font-size:1rem;margin:0 0 6px}.othercard p{margin:0;color:#5b554d}.footer{background:#111;color:#fff;padding:52px var(--pad)}.footer img{width:170px;filter:invert(1);margin:0 0 28px}.footer nav{display:flex;flex-wrap:wrap;gap:15px 24px;font-family:Montserrat;font-size:.82rem}.footer small{display:block;color:#aaa;margin-top:36px}
@media(min-width:800px){.hero{grid-template-columns:1.1fr .9fr}.hero__image{min-height:calc(100svh - 82px)}.hero__copy{padding:60px}.choicegrid{grid-template-columns:1fr 1fr}.choice:nth-child(odd){padding-right:35px}.choice:nth-child(even){padding-left:35px;border-left:1px solid var(--line)}.proof{display:grid;grid-template-columns:1fr 1fr}.proof__image{height:auto;min-height:620px}.proof__copy{display:flex;flex-direction:column;justify-content:center}.othergrid{grid-template-columns:repeat(3,1fr)}}
</style></head><body>
<header class="header"><a class="brand" href="/" aria-label="BHIC home"><img src="/assets/7732233b3dc43e88.png" alt="Bugungu"></a><button class="menu" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button></header><aside class="drawer" aria-hidden="true"><div class="drawer__top"><img src="/assets/7732233b3dc43e88.png" alt="Bugungu"><button class="close" aria-label="Close menu">×</button></div><nav class="nav"><a href="/">Home</a><a href="/about/">About</a><a href="/heritage/">Heritage &amp; Museum</a><a href="/visit/">Visit</a><a href="/contact/">Contact</a><a href="/support/" aria-current="page">Support</a></nav></aside>
<main><section class="hero"><div class="hero__image"><img src="/assets/33fac6597d1372e5.webp" alt="Hands playing a traditional stringed instrument"></div><div class="hero__copy"><p class="eyebrow">Support living heritage</p><h1>Help memory keep moving.</h1><p>Your support helps Bugungu knowledge pass from one person, object and generation to the next.</p><a class="btn" href="#give">See how to help</a></div></section>
<section class="thesis"><p class="eyebrow">Why it matters</p><blockquote>One generation can lose what hundreds built.</blockquote><p>BHIC works close to the people, places and practices that hold Bugungu’s memory. Support protects the time needed to listen, record, teach and care.</p></section>
<section class="choices"><p class="eyebrow">What support makes possible</p><h2>Choose what you want to keep moving.</h2><div class="choicegrid"><article class="choice"><span class="num">01</span><div><h3>Record living memory</h3><p>Support conversations with elders and knowledge holders before their stories are lost.</p></div></article><article class="choice"><span class="num">02</span><div><h3>Bring heritage to learners</h3><p>Help young people meet Bugungu knowledge in forms they can question, use and carry forward.</p></div></article><article class="choice"><span class="num">03</span><div><h3>Care for the collection</h3><p>Help BHIC document and safely care for objects entrusted to the community museum.</p></div></article><article class="choice"><span class="num">04</span><div><h3>Keep community work moving</h3><p>Support local travel, documentation and the practical work behind each recorded story.</p></div></article></div></section>
<section class="proof"><div class="proof__image"><img src="/assets/a7b047bbf6bcbe27.webp" alt="Young people and Bugungu Heritage Troupe members gathered with traditional drums"></div><div class="proof__copy"><p class="eyebrow">The work is alive</p><h2>Culture is carried by people.</h2><p>Support does not preserve Bugungu as something frozen. It gives people more ways to practise, discuss and transmit what they know.</p></div></section>
<section class="give" id="give"><p class="eyebrow" style="color:#111">Give safely</p><h2>Ask BHIC for the current way to contribute.</h2><p>Donation channels can change. Contact the team directly and we will confirm the correct, current details for your contribution.</p><div class="givebox"><h3>Tell us what matters to you</h3><p>You may support the work generally or begin a conversation around recording, learning, collection care or community fieldwork.</p></div><a class="btn" href="/contact/?reason=support">Request donation details</a><p class="safe">BHIC will never ask you to use unverified payment information shown outside its confirmed channels.</p></section>
<section class="other"><p class="eyebrow">More than money</p><h2>There are other ways in.</h2><div class="othergrid"><a class="othercard" href="/contact/?reason=story"><h3>Share knowledge</h3><p>Bring a story, object, name or memory into the conversation.</p></a><a class="othercard" href="/visit/"><h3>Visit the museum</h3><p>Come closer, ask questions and tell others what you found.</p></a><a class="othercard" href="/contact/?reason=partner"><h3>Open a door</h3><p>Introduce a school, researcher, funder or collaborator who should know BHIC.</p></a></div></section></main>
<footer class="footer"><img src="/assets/7732233b3dc43e88.png" alt="Bugungu"><nav><a href="/about/">About</a><a href="/heritage/">Heritage</a><a href="/visit/">Visit</a><a href="/contact/">Contact</a></nav><small>Bugungu Heritage and Information Centre · Buliisa, Uganda</small></footer><script is:inline>const drawer=document.querySelector('.drawer'),op=document.querySelector('.menu'),cl=document.querySelector('.close');function setMenu(v){drawer.classList.toggle('open',v);drawer.setAttribute('aria-hidden',!v);op.setAttribute('aria-expanded',v)}op.onclick=()=>setMenu(true);cl.onclick=()=>setMenu(false)</script></body></html>
