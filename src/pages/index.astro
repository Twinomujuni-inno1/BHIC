  <script is:inline>

    const lightbox = document.querySelector('#photo-lightbox');
    const lightboxImage = lightbox.querySelector('img');
    const lightboxCaption = lightbox.querySelector('p');
    document.querySelectorAll('[data-lightbox]').forEach(button => button.addEventListener('click', () => {
      const source = button.querySelector('img');
      const caption = button.closest('figure').querySelector('figcaption');
      lightboxImage.src = source.src;
      lightboxImage.alt = source.alt;
      lightboxCaption.textContent = caption.textContent;
      lightbox.showModal();
    }));
    lightbox.querySelector('.lightbox__close').addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', event => { if (event.target === lightbox) lightbox.close(); });

    const menuButton = document.querySelector('.menu-button');
    const drawer = document.querySelector('.drawer');
    const scrim = document.querySelector('.scrim');
    const setMenu = (open) => {
      drawer.classList.toggle('is-open', open); scrim.classList.toggle('is-open', open);
      drawer.setAttribute('aria-hidden', String(!open)); menuButton.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) drawer.querySelector('.drawer__close').focus(); else menuButton.focus();
    };
    menuButton.addEventListener('click', () => setMenu(true));
    document.querySelectorAll('[data-close-menu]').forEach(el => el.addEventListener('click', () => setMenu(false)));
    drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && drawer.classList.contains('is-open')) setMenu(false); });

    const museumCarousel = document.getElementById('museum-carousel');
    const museumSlides = [...museumCarousel.children];
    const museumDots = [...document.querySelectorAll('.carousel-shell .dot')];
    let museumIndex = 0;
    let museumTimer;

    const showMuseumSlide = (index, smooth = true) => {
      museumIndex = (index + museumSlides.length) % museumSlides.length;
      museumCarousel.scrollTo({ left: museumSlides[museumIndex].offsetLeft - museumCarousel.offsetLeft, behavior: smooth ? 'smooth' : 'auto' });
      museumDots.forEach((dot, i) => dot.classList.toggle('is-active', i === museumIndex));
    };
    const stopMuseumSlider = () => window.clearInterval(museumTimer);
    const startMuseumSlider = () => {
      stopMuseumSlider();
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        museumTimer = window.setInterval(() => showMuseumSlide(museumIndex + 1), 4800);
      }
    };
    const syncMuseumDots = () => {
      const nearest = museumSlides.reduce((best, slide, i) => Math.abs(slide.offsetLeft - museumCarousel.scrollLeft) < Math.abs(museumSlides[best].offsetLeft - museumCarousel.scrollLeft) ? i : best, 0);
      museumIndex = nearest;
      museumDots.forEach((dot, i) => dot.classList.toggle('is-active', i === museumIndex));
    };
    let museumScrollTick;
    museumCarousel.addEventListener('scroll', () => {
      window.clearTimeout(museumScrollTick);
      museumScrollTick = window.setTimeout(syncMuseumDots, 90);
    }, { passive: true });
    ['pointerdown', 'focusin', 'mouseenter'].forEach(event => museumCarousel.addEventListener(event, stopMuseumSlider));
    ['pointerup', 'focusout', 'mouseleave'].forEach(event => museumCarousel.addEventListener(event, startMuseumSlider));
    document.addEventListener('visibilitychange', () => document.hidden ? stopMuseumSlider() : startMuseumSlider());
    startMuseumSlider();

    const form = document.getElementById('signup-form');
    const toast = document.getElementById('toast');
    form.addEventListener('submit', e => {
      e.preventDefault(); if (!form.reportValidity()) return;
      toast.classList.add('is-visible'); form.reset();
      window.setTimeout(() => toast.classList.remove('is-visible'), 4300);
    });
  </script>
